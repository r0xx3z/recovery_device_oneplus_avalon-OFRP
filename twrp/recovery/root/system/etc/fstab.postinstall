#<src>      <mnt_point>   <type>  <mnt_flags and options>              <fs_mgr_flags>
system      /postinstall ext4    ro,nosuid,nodev,noexec,nofail         slotselect_other,logical,avb_keys=/product/etc/security/avb/system_other.avbpubkey
